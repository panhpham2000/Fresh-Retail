        "       - history_d2_sampled[\"sale_amount\"]).abs().mean())\n",
        "\n",
        "history_d2_sampled = history_d2_sampled.sort_values(\n",
        "    [\"series_id\", \"day_idx\"]\n",
        ").copy()\n",
        "\n",
        "gsaits_rec = history_d2_sampled.groupby(\"series_id\")[\n",
        "    \"recovered_daily_sales_saits_pypots\"\n",
        "]\n",
        "\n",
        "# Lag features\n",
        "history_d2_sampled[\"rec_sales_lag1_SAITS\"] = gsaits_rec.shift(1)\n",
        "history_d2_sampled[\"rec_sales_lag7_SAITS\"] = gsaits_rec.shift(7)\n",
        "\n",
        "# Leakage-free rolling features\n",
        "lag1saits_rec = gsaits_rec.shift(1)\n",
        "\n",
        "history_d2_sampled[\"rec_sales_roll7_SAITS\"] = (\n",
        "    lag1saits_rec.groupby(history_d2_sampled[\"series_id\"])\n",
        "    .rolling(window=7, min_periods=1)\n",

        "### 6a. WAPE Evaluation Function"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "id": "QQrYC_8uPLFc",
        "colab": {
          "base_uri": "https://localhost:8080/"

    {
      "cell_type": "markdown",
      "source": [
        "***Run the first 2 code cells of D2 - Dliear before run D2 - SAITS and D2 - iTransformer***"
      ],
      "metadata": {
        "id": "5i_LP8wnH3qt"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "from lightgbm import LGBMRegressor\n",
        "from pypots.imputation import Transformer\n",
        "\n",
        "print(\"\\n--- Transformer Recovery and LightGBM Forecasting ---\")\n",
        "\n",
        "# =========================\n",
        "# 1. Prepare 3D data (reusing existing X_sales_3d_nan)X_sales_3d_nan, num_series_unique, num_days_unique, num_hours_op, series_id_to_idx, day_idx_to_idx\n",
        "#    are assumed to be defined from previous DLinear/SAITS PyPOTS cells.\n",
        "# =========================\n",
        "\n",
        "# Ensure device is set (already defined in previous cells)\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(\"Using device:\", device)\n",
        "\n",
        "# =========================\n",
        "# 2. Mask validation period to avoid leakage\n",
        "# =========================\n",
        "\n",
        "val_start_day_idx = val_d2_sampled[\"day_idx\"].min()\n",
        "train_days_count = day_idx_to_idx[val_start_day_idx]\n",
        "\n",
        "X_train_for_transformer_imputation = X_sales_3d_nan.copy()\n",
        "\n",
        "# Mask future validation days as NaN during fitting\n",
        "X_train_for_transformer_imputation[:, train_days_count:, :] = np.nan\n",
        "\n",
        "train_data_for_pypots_transformer_fit = {\n",
        "    \"X\": X_train_for_transformer_imputation\n",
        "}\n",
        "\n",
        "# =========================\n",
        "# 3. Train PyPOTS Transformer\n",
        "# =========================\n",
        "\n",
        "model_transformer_pypots = Transformer(\n",
        "    n_steps=num_days_unique,\n",
        "    n_features=num_hours_op,\n",
        "    n_layers=2,\n",
        "    n_heads=4,\n",
        "    d_model=128,\n",
        "    d_k=32, # Value from SAITS example\n",
        "    d_v=32, # Value from SAITS example\n",
        "    d_ffn=256, # Value from SAITS example\n",
        "    epochs=10,\n",
        "    batch_size=32,\n",
        "    device=device\n",
        ")\n",
        "\n",
        "print(\"\\nTraining Transformer model...\")\n",
        "model_transformer_pypots.fit(train_data_for_pypots_transformer_fit)\n",
        "print(\"Transformer model training complete.\")\n",
        "\n",
        "# =========================\n",
        "# 4. Impute full sampled data\n",
        "# =========================\n",
        "\n",
        "imputed_sales_transformer_3d = model_transformer_pypots.impute({\n",
        "    \"X\": X_sales_3d_nan\n",
        "})\n",
        "\n",
        "# Convert to numpy if needed\n",
        "if isinstance(imputed_sales_transformer_3d, torch.Tensor):\n",
        "    imputed_sales_transformer_3d = imputed_sales_transformer_3d.detach().cpu().numpy()\n",
        "\n",
        "# =========================\n",
        "# 5. Map 3D imputed data back to 2D hourly rows\n",
        "# =========================\n",
        "\n",
        "imputed_op_sales_transformer_pypots = np.zeros_like(op_sales_masked_d2_sampled, dtype=np.float32)\n",
        "\n",
        "for row_pos, (_, row) in enumerate(history_d2_sampled.iterrows()):\n",
        "    s_idx = series_id_to_idx[row[\"series_id\"]]\n",
        "    d_idx = day_idx_to_idx[row[\"day_idx\"]]\n",
        "    imputed_op_sales_transformer_pypots[row_pos, :] = imputed_sales_transformer_3d[s_idx, d_idx, :]\n",
        "\n",
        "imputed_op_sales_transformer_pypots = np.maximum(0, imputed_op_sales_transformer_pypots)\n",
        "\n",
        "# =========================\n",
        "# 6. Rebuild recovered daily sales\n",
        "# =========================\n",
        "\n",
        "visible_sum_transformer = np.nansum(\n",
        "    np.where(op_stock_d2_sampled == 0, op_sales_d2_sampled, 0),\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "recovered_sum_transformer = np.sum(imputed_op_sales_transformer_pypots, axis=1)\n",
        "\n",
        "outside_slice_transformer = np.maximum(\n",
        "    history_d2_sampled[\"sale_amount\"].values.astype(np.float32) - visible_sum_transformer,\n",
        "    0\n",
        ")\n",
        "\n",
        "recovered_daily_transformer = outside_slice_transformer + recovered_sum_transformer\n",
        "\n",
        "history_d2_sampled[\"recovered_daily_sales_transformer_pypots\"] = recovered_daily_transformer\n",
        "\n",
        "print(\"Mean raw sale_amount:\",\n",
        "      history_d2_sampled[\"sale_amount\"].mean())\n",
        "\n",
        "print(\"Mean recovered Transformer:\",\n",
        "      history_d2_sampled[\"recovered_daily_sales_transformer_pypots\"].mean())\n",
        "\n",
        "print(\"Mean absolute difference:\",\n",
        "      (history_d2_sampled[\"recovered_daily_sales_transformer_pypots\"]\n",
        "       - history_d2_sampled[\"sale_amount\"]).abs().mean())\n",
        "\n",
        "# =====================================================\n",
        "# 7. Recompute lag and rolling features from recovered demand\n",
        "# =====================================================\n",
        "\n",
        "history_d2_sampled = history_d2_sampled.sort_values(\n",
        "    [\"series_id\", \"day_idx\"]\n",
        ").copy()\n",
        "\n",
        "gtr_rec = history_d2_sampled.groupby(\"series_id\")[\n",
        "    \"recovered_daily_sales_transformer_pypots\"\n",
        "]\n",
        "\n",
        "# Lag features\n",
        "history_d2_sampled[\"rec_sales_lag1_TR\"] = gtr_rec.shift(1)\n",
        "history_d2_sampled[\"rec_sales_lag7_TR\"] = gtr_rec.shift(7)\n",
        "\n",
        "# Leakage-free rolling features\n",
        "lag1tr_rec = gtr_rec.shift(1)\n",
        "\n",
        "history_d2_sampled[\"rec_sales_roll7_TR\"] = (\n",
        "    lag1tr_rec.groupby(history_d2_sampled[\"series_id\"])\n",
        "    .rolling(window=7, min_periods=1)\n",
        "    .mean()\n",
        "    .reset_index(level=0, drop=True)\n",
        ")\n",
        "\n",
        "history_d2_sampled[\"rec_sales_roll28_TR\"] = (\n",
        "    lag1tr_rec.groupby(history_d2_sampled[\"series_id\"])\n",
        "    .rolling(window=28, min_periods=1)\n",
        "    .mean()\n",
        "    .reset_index(level=0, drop=True)\n",
        ")\n",
        "\n",
        "print(\"Recovered lag/rolling features created for Transformer.\")\n",
        "\n",
        "# =========================\n",
        "# 8. Split after recovered target is created\n",
        "# =========================\n",
        "\n",
        "train_r_transformer_pypots, val_r_transformer_pypots = time_split(\n",
        "    history_d2_sampled,\n",
        "    horizon=7\n",
        ")\n",
        "\n",
        "# =========================\n",
        "# 9. Train LightGBM on recovered target\n",
        "# =========================\n",
        "\n",
        "features_lgbm_TR = [\n",
        "    \"rec_sales_lag1_TR\",\n",
        "    \"rec_sales_lag7_TR\",\n",
        "    \"rec_sales_roll7_TR\",\n",
        "    \"rec_sales_roll28_TR\",\n",
        "    \"avg_temperature\",\n",
        "    \"management_group_id\",\n",
        "    \"city_id\",\n",
        "    \"product_id\",\n",
        "    \"holiday_flag\",\n",
        "    \"discount\",\n",
        "    \"is_censored\"\n",
        "]\n",
        "\n",
        "target_lgbm_TR = \"recovered_daily_sales_transformer_pypots\"\n",
        "\n",
        "# Fill NaN values in the target column of the validation set with 0 before dropping rows\n",
        "val_r_transformer_pypots[target_lgbm_TR] = val_r_transformer_pypots[target_lgbm_TR].fillna(0)\n",
        "\n",
        "# Fill NaN values in feature columns for both train and validation sets with 0\n",
        "for feature in features_lgbm_TR:\n",
        "    if feature in train_r_transformer_pypots.columns:\n",
        "        train_r_transformer_pypots[feature] = train_r_transformer_pypots[feature].fillna(0)\n",
        "    if feature in val_r_transformer_pypots.columns:\n",
        "        val_r_transformer_pypots[feature] = val_r_transformer_pypots[feature].fillna(0)\n",
        "\n",
        "train_lgbm_tr = train_r_transformer_pypots.dropna(subset=features_lgbm_TR + [target_lgbm_TR]).copy()\n",
        "val_lgbm_tr = val_r_transformer_pypots.dropna(subset=features_lgbm_TR + [target_lgbm_TR]).copy()\n",
        "\n",
        "model_lgbm_tr = LGBMRegressor(random_state=RANDOM_SEED)\n",
        "\n",
        "print(\"\\nTraining LightGBM on Transformer recovered data...\")\n",
        "model_lgbm_tr.fit(\n",
        "    train_lgbm_tr[features_lgbm_TR],\n",
        "    train_lgbm_tr[target_lgbm_TR]\n",
        ")\n",
        "print(\"LightGBM training complete.\")\n",
        "\n",
        "val_lgbm_tr[\"prediction\"] = model_lgbm_tr.predict(\n",
        "    val_lgbm_tr[features_lgbm_TR]\n",
        ").clip(min=0)\n",
        "\n",
        "# =========================\n",
        "# 10. Evaluate with evaluate_forecast function\n",
        "# =========================\n",
        "\n",
        "val_eval_tr = val_lgbm_tr.copy()\n",
        "\n",
        "# Important: evaluate_forecast uses \"sale_amount\" as actual target.\n",
        "# So replace sale_amount with recovered target for D2 evaluation.\n",
        "val_eval_tr[\"sale_amount\"] = val_eval_tr[target_lgbm_TR]\n",
        "\n",
        "transformer_pypots_lgbm_results = evaluate_forecast(\n",
        "    val_eval_tr,\n",
        "    pred_col=\"prediction\"\n",
        ")\n",
        "\n",
        "print(\"\\n=== Transformer with PyPOTS Recovered Data Results ===\")\n",
        "print(transformer_pypots_lgbm_results)\n",
        "\n",

        "# Add temporary tracking columns to group the hourly matrices cleanly\n",
        "df_d2_mean[\"row_idx\"] = np.arange(len(df_d2_mean))\n",
        "\n",
        "# Calculate the mean profile for every series ID across training data only\n",
        "# Using nanmean ignores masked stockouts, capturing the unconstrained rate\n",
        "train_masked_df = pd.DataFrame(op_sales_masked[is_train_row])\n",
        "train_masked_df[\"series_id\"] = df_d2_mean.loc[is_train_row, \"series_id\"].values\n",
        "\n",
        "# Generate the historical profile lookup dictionary\n",
        "hourly_profile_lookup = train_masked_df.groupby(\"series_id\").mean().to_dict(orient=\"index\")\n",
        "\n",
        "print(\"=== Step 3: Imputing Missing Target Boundaries ===\")\n",
        "# Fill in the NaN values using the historical hourly averages\n",
        "series_ids_array = df_d2_mean[\"series_id\"].values\n",

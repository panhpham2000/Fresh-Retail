        "# =========================\n",
        "# 7. Rebuild recovered daily sales\n",
        "# 8. Recompute lag and rolling features from recovered demand\n",
        "# 9. Split after recovered target is created\n",
        "# =========================\n",
        "\n",
        "visible_sum_saits = np.nansum(\n",
        "    np.where(op_stock_d2_sampled == 0, op_sales_d2_sampled, 0),\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "recovered_sum_saits = np.sum(imputed_op_sales_saits_pypots, axis=1)\n",
        "\n",
        "outside_slice_saits = np.maximum(\n",
        "    history_d2_sampled[\"sale_amount\"].values.astype(np.float32) - visible_sum_saits,\n",
        "    0\n",
        ")\n",
        "\n",
        "recovered_daily_saits = outside_slice_saits + recovered_sum_saits\n",
        "\n",
        "history_d2_sampled[\"recovered_daily_sales_saits_pypots\"] = recovered_daily_saits\n",
        "\n",
        "print(\"Mean raw sale_amount:\",\n",
        "      history_d2_sampled[\"sale_amount\"].mean())\n",
        "\n",
        "print(\"Mean recovered SAITS:\",\n",
        "      history_d2_sampled[\"recovered_daily_sales_saits_pypots\"].mean())\n",
        "\n",
        "print(\"Mean absolute difference:\",\n",

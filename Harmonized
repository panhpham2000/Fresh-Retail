        "\n",
        "    hm = np.nan if (np.isnan(wape_low) or np.isnan(wape_high) or wape_all == 0) else 3 / (1/wape_all + 1/wape_low + 1/wape_high)\n",
        "    return {\"wape_overall\": round(wape_all, 4), \"wape_low_sale\": round(wape_low, 4), \"wape_high_sale\": round(wape_high, 4), \"harmonic_mean\": round(hm, 4)}\n",
        "\n",
        "# --- ARCHITECTURAL DEFINITIONS ---\n",
        "class MovingAverage(nn.Module):\n",
        "    def __init__(self, kernel_size, stride):\n",
        "        super().__init__()\n",
        "        self.kernel_size = kernel_size\n",
        "        self.avg = nn.AvgPool1d(kernel_size=kernel_size, stride=stride, padding=0)\n",
        "\n",
        "    def forward(self, x):\n",

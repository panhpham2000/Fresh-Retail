        "\n",
        "# Convert to numpy if needed\n",
        "if isinstance(imputed_sales_transformer_3d, torch.Tensor):\n",
        "    imputed_sales_transformer_3d = imputed_sales_transformer_3d.detach().cpu().numpy()\n",
        "\n",
        "# =========================\n",
        "# 5. Map 3D imputed data back to 2D hourly rows\n",
        "# =========================\n",
        "\n",
        "imputed_op_sales_transformer_pypots = np.zeros_like(op_sales_masked_d2_sampled, dtype=np.float32)\n",
        "\n",
        "for row_pos, (_, row) in enumerate(history_d2_sampled.iterrows()):\n",
        "    s_idx = series_id_to_idx[row[\"series_id\"]]\n",
        "    d_idx = day_idx_to_idx[row[\"day_idx\"]]\n",
        "    imputed_op_sales_transformer_pypots[row_pos, :] = imputed_sales_transformer_3d[s_idx, d_idx, :]\n",
        "\n",
        "imputed_op_sales_transformer_pypots = np.maximum(0, imputed_op_sales_transformer_pypots)\n",
        "\n",
        "# =========================\n",
        "# 6. Rebuild recovered daily sales\n",
        "# =========================\n",
        "\n",
        "visible_sum_transformer = np.nansum(\n",
        "    np.where(op_stock_d2_sampled == 0, op_sales_d2_sampled, 0),\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "recovered_sum_transformer = np.sum(imputed_op_sales_transformer_pypots, axis=1)\n",
        "\n",
        "outside_slice_transformer = np.maximum(\n",
        "    history_d2_sampled[\"sale_amount\"].values.astype(np.float32) - visible_sum_transformer,\n",

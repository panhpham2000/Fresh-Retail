        "model_transformer_pypots.fit(train_data_for_pypots_transformer_fit)\n",
        "print(\"Transformer model training complete.\")\n",
        "\n",
        "# =========================\n",
        "# 4. Impute full sampled data\n",
        "# =========================\n",
        "\n",
        "imputed_sales_transformer_3d = model_transformer_pypots.impute({\n",
        "    \"X\": X_sales_3d_nan\n",

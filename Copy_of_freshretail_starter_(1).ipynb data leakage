        "}\n",
        "\n",
        "# =========================\n",
        "# 3. Train PyPOTS Transformer\n",
        "# =========================\n",
        "\n",
        "model_transformer_pypots = Transformer(\n",
        "    n_steps=num_days_unique,\n",
        "    n_features=num_hours_op,\n",
        "    n_layers=2,\n",
        "    n_heads=4,\n",
        "    d_model=128,\n",
        "    d_k=32, # Value from SAITS example\n",
        "    d_v=32, # Value from SAITS example\n",
        "    d_ffn=256, # Value from SAITS example\n",

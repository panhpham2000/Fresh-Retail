        "        # Output will be [Batch, Channel, Pred_length]\n",
        "        # Permute back to [Batch, Pred_length, Channel]\n",
        "\n",
        "        seasonal_output = self.linear_seasonal(seasonal.permute(0, 2, 1)).permute(0, 2, 1)\n",
        "        trend_output = self.linear_trend(trend.permute(0, 2, 1)).permute(0, 2, 1)\n",
        "\n",
        "        return seasonal_output + trend_output\n",
        "\n",
        "# --- 1. SETTINGS & EXPERIMENT GRID ---\n",
        "input_len = 28\n",
        "pred_len = 7\n",
        "batch_size = 1024  # Increased batch size to handle the huge dataset faster\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# Hyperparameters to test on the full dataset\n",
        "learning_rates = [0.001, 0.005]\n",
        "epochs_to_test = [3, 5]\n",
        "\n",
        "print(\"=== Starting Full Dataset Vectorized Data Prep ===\")\n",
        "start_time = time.time()\n",
        "\n",
        "# Re-create train and val to ensure they are defined in this scope\n",
        "train, val = time_split(history, horizon=7)\n",
        "\n",
        "# Define train_dlinear_full_data and val_dlinear_full_data using the already loaded 'train' and 'val' dataframes\n",
        "train_dlinear_full_data = train.copy()\n",
        "val_dlinear_full_data = val.copy()\n",
        "\n",
        "# --- 2. FAST VECTORIZED SEQUENCE GENERATION (No Loops!) ---\n",
        "# Ensure your dataframes are sorted by series and time index\n",
        "train_sorted = train_dlinear_full_data.sort_values(['series_id', 'day_idx'])\n",
        "val_sorted = val_dlinear_full_data.sort_values(['series_id', 'day_idx'])\n",
        "\n",
        "# Pivot the dataframes to get shape: (50000 series, 83 train days)\n",
        "train_pivot = train_sorted.pivot(index='series_id', columns='day_idx', values='sale_amount').values\n",
        "val_pivot = val_sorted.pivot(index='series_id', columns='day_idx', values='sale_amount').values\n",
        "\n",
        "# Fit global scaler across all historical values at once\n",
        "scaler = MinMaxScaler()\n",
        "train_pivot_scaled = scaler.fit_transform(train_pivot.T).T  # Shape keeps (50000, 83)\n",
        "\n",
        "# Slide a window across the matrix arrays simultaneously\n",
        "X_sequences = []\n",
        "Y_sequences = []\n",
        "for i in range(train_pivot_scaled.shape[1] - input_len - pred_len + 1):\n",
        "    X_sequences.append(train_pivot_scaled[:, i : i + input_len])\n",
        "    Y_sequences.append(train_pivot_scaled[:, i + input_len : i + input_len + pred_len])\n",
        "\n",
        "# Stack into final shapes: (Total Sequences, input_len, 1)\n",
        "global_train_x = np.vstack(X_sequences)[:, :, np.newaxis]\n",
        "global_train_y = np.vstack(Y_sequences)[:, :, np.newaxis]\n",
        "\n",
        "# Extract the final 28 days of training data per series to act as the validation input matrix\n",
        "val_input_raw = train_pivot[:, -input_len:]\n",
        "val_input_scaled = scaler.transform(val_input_raw.T).T[:, :, np.newaxis]\n",
        "\n",
        "# Convert arrays straight to PyTorch Tensors\n",
        "train_tensor_x = torch.tensor(global_train_x, dtype=torch.float32).to(device)\n",
        "train_tensor_y = torch.tensor(global_train_y, dtype=torch.float32).to(device)\n",
        "val_tensor_x = torch.tensor(val_input_scaled, dtype=torch.float32).to(device)\n",
        "\n",
        "print(f\"Data prepared in {time.time() - start_time:.2f}s. Total sequences: {train_tensor_x.shape[0]}\")\n",
        "\n",
        "# --- 3. THE HYPERPARAMETER TUNING LOOP ---\n",
        "tuning_results = []\n",
        "\n",
        "for lr in learning_rates:\n",
        "    for epochs in epochs_to_test:\n",
        "        print(f\"\\n--- Training on Full Dataset: LR={lr}, Epochs={epochs} ---\")\n",
        "\n",
        "        # Initialize Fresh DLinear Model\n",
        "        global_model = DLinear(input_len=input_len, pred_len=pred_len).to(device)\n",
        "        optimizer = optim.Adam(global_model.parameters(), lr=lr)\n",
        "        criterion = nn.MSELoss()\n",
        "\n",
        "        train_dataset = TensorDataset(train_tensor_x, train_tensor_y)\n",
        "        train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)\n",
        "\n",
        "        # Train Loop\n",
        "        global_model.train()\n",
        "        for epoch in range(epochs):\n",
        "            epoch_loss = 0\n",
        "            for batch_x, batch_y in train_loader:\n",
        "                optimizer.zero_grad()\n",
        "                output = global_model(batch_x)\n",
        "                loss = criterion(output, batch_y)\n",
        "                loss.backward()\n",
        "                optimizer.step()\n",
        "                epoch_loss += loss.item()\n",
        "\n",
        "        # Fast Global Inference on the validation period\n",
        "        global_model.eval()\n",
        "        with torch.no_grad():\n",
        "            forecast_scaled = global_model(val_tensor_x).cpu().numpy().squeeze(-1)\n",
        "            # Inverse transform back to raw sales metrics\n",
        "            forecast_raw = scaler.inverse_transform(forecast_scaled.T).T\n",
        "\n",
        "        # Build evaluation dataframe matching the architecture of your 'evaluate_forecast' function\n",
        "        # Create a copy of the validation base dataframe to inject your predictions\n",
        "        val_eval_df = val_sorted.copy()\n",
        "\n",
        "        # Fast array assignment matching series mappings\n",
        "        pred_map = dict(zip(train_sorted['series_id'].unique(), forecast_raw))\n",
        "\n",
        "        # Assign the calculated step predictions straight into a flattened series slice array\n",
        "        # Create a sequential prediction array matched to your validation dates\n",
        "        preds_list = []\n",
        "        for sid in val_eval_df['series_id'].unique():\n",
        "            preds_list.extend(pred_map[sid])\n",
        "\n",
        "        val_eval_df['dlinear_prediction'] = preds_list\n",
        "        val_eval_df['dlinear_prediction'] = val_eval_df['dlinear_prediction'].clip(lower=0)\n",
        "\n",
        "        # Calculate WAPE metrics using your built-in evaluation hook\n",
        "        res = evaluate_forecast(val_eval_df, pred_col=\"dlinear_prediction\")\n",
        "        print(f\"Resulting Overall WAPE: {res['wape_overall']}\")\n",
        "\n",
        "tuning_results.append({\n",
        "            'learning_rate': lr,\n",
        "            'epochs': epochs,\n",
        "            'wape_overall': res['wape_overall']\n",
        "})\n",
        "\n",
        "tuning_results_df = pd.DataFrame(tuning_results)\n",
        "print(\"\\n=== Tuning Complete across Full 50,000 Dataset ===\")\n",
        "print(tuning_results_df)"

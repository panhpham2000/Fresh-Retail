        "\n",
        "target_lgbm_TR = \"recovered_daily_sales_transformer_pypots\"\n",
        "\n",
        "# Fill NaN values in the target column of the validation set with 0 before dropping rows\n",
        "val_r_transformer_pypots[target_lgbm_TR] = val_r_transformer_pypots[target_lgbm_TR].fillna(0)\n",
        "\n",
        "# Fill NaN values in feature columns for both train and validation sets with 0\n",
        "for feature in features_lgbm_TR:\n",
        "    if feature in train_r_transformer_pypots.columns:\n",
        "        train_r_transformer_pypots[feature] = train_r_transformer_pypots[feature].fillna(0)\n",
        "    if feature in val_r_transformer_pypots.columns:\n",
        "        val_r_transformer_pypots[feature] = val_r_transformer_pypots[feature].fillna(0)\n",
        "\n",
        "train_lgbm_tr = train_r_transformer_pypots.dropna(subset=features_lgbm_TR + [target_lgbm_TR]).copy()\n",
        "val_lgbm_tr = val_r_transformer_pypots.dropna(subset=features_lgbm_TR + [target_lgbm_TR]).copy()\n",
        "\n",
        "model_lgbm_tr = LGBMRegressor(random_state=RANDOM_SEED)\n",

        "# =========================\n",
        "\n",
        "train_r_transformer_pypots, val_r_transformer_pypots = time_split(\n",
        "    history_d2_sampled,\n",
        "    horizon=7\n",
        ")\n",
        "\n",
        "# =========================\n",
        "# 9. Train LightGBM on recovered target\n",
        "# =========================\n",
        "\n",
        "features_lgbm_TR = [\n",
        "    \"rec_sales_lag1_TR\",\n",
        "    \"rec_sales_lag7_TR\",\n",
        "    \"rec_sales_roll7_TR\",\n",
        "    \"rec_sales_roll28_TR\",\n",

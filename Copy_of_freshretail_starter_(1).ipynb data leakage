        "        for h in range(16):\n",
        "            if np.isnan(imputed_pshm[i, h]):\n",
        "                imputed_pshm[i, h] = 0\n",
        "\n",
        "\n",
        "# Rebuild corrected daily target (using the imputed_pshm which now covers the full history)\n",
        "# visible_sum is from the original op_sales (non-censored hours)\n",

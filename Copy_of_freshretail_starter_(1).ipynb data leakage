        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Ensure device is set\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# --- DLinear Model Definition (copied for self-containment) ---\n",
        "class MovingAverage(nn.Module):\n",
        "    def __init__(self, kernel_size, stride):\n",
        "        super().__init__()\n",
        "        self.kernel_size = kernel_size\n",
        "        self.avg = nn.AvgPool1d(kernel_size=kernel_size, stride=stride, padding=0)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # x: [Batch, Input length, Channel]\n",
        "        # Padding for avg pool: (kernel_size - 1) // 2 on each side\n",
        "        pad_size = (self.kernel_size - 1) // 2\n",
        "        front = x[:, 0:1, :].repeat(1, pad_size, 1)\n",
        "        end = x[:, -1:, :].repeat(1, pad_size, 1)\n",
        "        x_padded = torch.cat([front, x, end], dim=1) # [Batch, Input length + 2*pad_size, Channel]\n",
        "\n",
        "        # AvgPool1d expects (Batch, Channel, Sequence_Length)\n",
        "        x_permuted = x_padded.permute(0, 2, 1) # [Batch, Channel, Input length + 2*pad_size]\n",
        "        trend = self.avg(x_permuted) # [Batch, Channel, Input length] (stride 1 means output length is input length after padding and pooling)\n",
        "        trend = trend.permute(0, 2, 1) # [Batch, Input length, Channel]\n",
        "        return trend\n",
        "\n",
        "class DLinear(nn.Module):\n",
        "    def __init__(self, input_len, pred_len, kernel_size=25):\n",
        "        super().__init__()\n",
        "        self.input_len = input_len\n",
        "        self.pred_len = pred_len\n",
        "        self.kernel_size = kernel_size\n",
        "\n",
        "        self.moving_avg = MovingAverage(kernel_size, stride=1)\n",
        "        # Linear layer expects (Batch, *, in_features) where in_features is the last dimension\n",
        "        # Our input x after permute is [Batch, Channel, Input_length]\n",
        "        # So, the linear layer should operate on Input_length\n",
        "        self.linear_seasonal = nn.Linear(input_len, pred_len)\n",
        "        self.linear_trend = nn.Linear(input_len, pred_len)\n",
        "\n",
        "        # Initialize weights (often set to identity or similar for DLinear)\n",
        "        nn.init.constant_(self.linear_seasonal.weight, 1.0 / input_len)\n",
        "        nn.init.constant_(self.linear_trend.weight, 1.0 / input_len)\n",
        "        nn.init.constant_(self.linear_seasonal.bias, 0.0)\n",
        "        nn.init.constant_(self.linear_trend.bias, 0.0)\n",
        "\n",
        "    def forward(self, x): # x: [Batch, Input length, Channel]\n",
        "        # Decompose the input\n",
        "        trend = self.moving_avg(x)\n",
        "        seasonal = x - trend\n",
        "\n",
        "        # For linear layers, permute x to [Batch, Channel, Input_length]\n",
        "        # Then apply linear layer which maps Input_length to Pred_length\n",
        "        # Output will be [Batch, Channel, Pred_length]\n",
        "        # Permute back to [Batch, Pred_length, Channel]\n",
        "\n",
        "        seasonal_output = self.linear_seasonal(seasonal.permute(0, 2, 1)).permute(0, 2, 1)\n",
        "        trend_output = self.linear_trend(trend.permute(0, 2, 1)).permute(0, 2, 1)\n",
        "\n",
        "        return seasonal_output + trend_output\n",
        "\n",
        "# --- Parameters ---\n",
        "input_len = 28 # Lookback window (encoder length)\n",
        "pred_len = 7   # Forecast horizon (decoder length)\n",
        "epochs = 5     # Number of training epochs\n",
        "learning_rate = 0.001\n",
        "batch_size = 128\n",
        "kernel_size = 25 # Reusing the kernel size from previous DLinear for consistency\n",
        "\n",
        "print(\"\\n--- DLinear Global Model Training on SAITS-recovered daily sales ---\")\n",
        "\n",
        "# Data source: SAITS-recovered data\n",
        "target_col = \"recovered_daily_sales_saits_pypots\"\n",
        "\n",
        "# Ensure series_id columns are integer type\n",
        "train_r_saits_pypots[\"series_id\"] = train_r_saits_pypots[\"series_id\"].astype(int)\n",
        "val_r_saits_pypots[\"series_id\"] = val_r_saits_pypots[\"series_id\"].astype(int)\n",
        "\n",
        "# 1. GLOBAL SCALER: Fit on all training data once\n",
        "scaler_dlinear_saits = MinMaxScaler()\n",
        "all_train_saits_sales_data = train_r_saits_pypots[target_col].values.reshape(-1, 1)\n",
        "scaler_dlinear_saits.fit(all_train_saits_sales_data)\n",
        "\n",
        "# 2. AGGREGATE TRAINING DATA: Collect sequences from all series\n",
        "all_global_train_data_x_dlinear_saits, all_global_train_data_y_dlinear_saits = [], []\n",
        "processed_series_for_global_training = 0\n",
        "\n",
        "unique_series_ids_saits = train_r_saits_pypots[\"series_id\"].unique()\n",
        "\n",
        "for series_id in unique_series_ids_saits:\n",
        "    train_series_df = train_r_saits_pypots[train_r_saits_pypots[\"series_id\"] == series_id].copy()\n",
        "\n",
        "    # Skip if not enough data to form at least one sequence of input_len + pred_len\n",
        "    if len(train_series_df) < input_len + pred_len:\n",
        "        continue\n",
        "\n",
        "    # Scale data for this series using the GLOBAL scaler\n",
        "    train_sales_scaled = scaler_dlinear_saits.transform(train_series_df[target_col].values.reshape(-1, 1))\n",
        "\n",
        "    # Prepare training sequences (input X, target Y)\n",
        "    for i in range(len(train_sales_scaled) - input_len - pred_len + 1):\n",
        "        all_global_train_data_x_dlinear_saits.append(train_sales_scaled[i : i + input_len]) # [input_len, 1]\n",
        "        all_global_train_data_y_dlinear_saits.append(train_sales_scaled[i + input_len : i + input_len + pred_len]) # [pred_len, 1]\n",
        "    processed_series_for_global_training += 1\n",
        "\n",
        "print(f\"Aggregated training data from {processed_series_for_global_training} series.\")\n",
        "\n",
        "if not all_global_train_data_x_dlinear_saits:\n",
        "    print(\"No sufficient training data to form sequences for global DLinear model on SAITS-recovered data.\")\n",
        "else:\n",
        "    # 3. GLOBAL DATALOADER\n",
        "    global_train_tensor_x = torch.tensor(np.array(all_global_train_data_x_dlinear_saits), dtype=torch.float32).to(device)\n",
        "    global_train_tensor_y = torch.tensor(np.array(all_global_train_data_y_dlinear_saits), dtype=torch.float32).to(device)\n",
        "    global_train_dataset = TensorDataset(global_train_tensor_x, global_train_tensor_y)\n",
        "    global_train_loader = DataLoader(global_train_dataset, batch_size=batch_size, shuffle=True)\n",
        "\n",
        "    # 4. INITIALIZE GLOBAL MODEL (once)\n",
        "    global_model_dlinear_saits = DLinear(input_len=input_len, pred_len=pred_len, kernel_size=kernel_size).to(device)\n",
        "    global_optimizer_dlinear_saits = optim.Adam(global_model_dlinear_saits.parameters(), lr=learning_rate)\n",
        "    global_criterion_dlinear_saits = nn.MSELoss()\n",
        "\n",
        "    # 5. TRAIN GLOBAL MODEL\n",
        "    global_model_dlinear_saits.train()\n",
        "    print(f\"Training global DLinear model for {epochs} epochs on {len(global_train_dataset)} sequences...\")\n",
        "    for epoch_idx in range(epochs):\n",
        "        epoch_loss = 0\n",
        "        for batch_x, batch_y in global_train_loader:\n",
        "            global_optimizer_dlinear_saits.zero_grad()\n",
        "            output = global_model_dlinear_saits(batch_x)\n",
        "            loss = global_criterion_dlinear_saits(output, batch_y)\n",
        "            loss.backward()\n",
        "            global_optimizer_dlinear_saits.step()\n",
        "            epoch_loss += loss.item()\n",
        "        print(f\"Epoch {epoch_idx+1}/{epochs}, Loss: {epoch_loss / len(global_train_loader):.4f}\")\n",
        "\n",
        "    # 6. PER-SERIES PREDICTION using the single trained global model\n",
        "    all_forecasts_dlinear_saits = []\n",
        "    series_processed_for_prediction = 0\n",
        "    global_model_dlinear_saits.eval() # Set model to evaluation mode\n",
        "\n",
        "    print(\"\\n--- Making predictions with global DLinear model on SAITS-recovered data ---\")\n",
        "    val_pred_df = val_r_saits_pypots.copy() # Make a copy to store predictions\n",
        "    val_pred_df[\"dlinear_saits_prediction\"] = np.nan # Initialize prediction column\n",
        "\n",
        "    for series_id in val_r_saits_pypots[\"series_id\"].unique():\n",
        "        # Get training data for this series to form the prediction input\n",
        "        train_series_data_for_pred = train_r_saits_pypots[train_r_saits_pypots[\"series_id\"] == series_id].copy()\n",
        "        val_series_data_for_pred = val_r_saits_pypots[val_r_saits_pypots[\"series_id\"] == series_id].copy()\n",
        "\n",
        "        # Skip if not enough historical data for the input window or no validation data\n",
        "        if len(train_series_data_for_pred) < input_len or len(val_series_data_for_pred) == 0:\n",
        "            continue\n",
        "\n",
        "        # Prepare validation input (encoder input from last `input_len` days of train data)\n",
        "        val_input_sales_raw = train_series_data_for_pred[target_col].values[-input_len:]\n",
        "        # Scale using the GLOBAL scaler\n",
        "        val_input_sales_scaled = scaler_dlinear_saits.transform(val_input_sales_raw.reshape(-1, 1)) # Should be [input_len, 1]\n",
        "\n",
        "        # Add batch dimension and move to device: [1, input_len, 1]\n",
        "        val_input_tensor = torch.tensor(val_input_sales_scaled, dtype=torch.float32).unsqueeze(0).to(device)\n",

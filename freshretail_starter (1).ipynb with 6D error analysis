        "op_stock_d2_sampled = hourly_stock_ds_d2_sampled[:, 6:22].astype(np.float32)\n",
        "\n",
        "# Mark censored hours\n",
        "op_sales_masked_d2_sampled = np.where(op_stock_d2_sampled == 1, np.nan, op_sales_d2_sampled)\n",

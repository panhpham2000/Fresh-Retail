        "model_random_pool.fit(train_Lgbm_random_pool[features], train_Lgbm_random_pool[target_lgbm_random_pool])\n",
        "\n",
        "val_Lgbm_random_pool[\"prediction\"] = model_random_pool.predict(\n",
        "    val_Lgbm_random_pool[features]\n",
        ").clip(min=0)\n",
        "\n",
